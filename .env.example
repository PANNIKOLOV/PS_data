# =============================================================================
# Supabase
# Project settings → API. The publishable/anon key is safe in the browser;
# Row Level Security is what protects the data behind it.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses Row Level Security. Server-side only — never expose to the browser.
# Used by the sync engine and by admin user provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Credential encryption
# Encrypts PrestaShop webservice keys at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
#
# Changing this makes existing stored keys unreadable; they must be re-entered.
# =============================================================================
CREDENTIALS_ENCRYPTION_KEY=

# =============================================================================
# Scheduled sync (optional)
# Shared secret required by POST /api/cron/sync. Generate with:
#   openssl rand -hex 32
# Leave unset to disable the scheduled endpoint entirely.
# =============================================================================
SYNC_CRON_SECRET=b6940de3a0a5f6b383d66c636a7d148524d2feeeb6e2052199e339df6d6d80c4

# =============================================================================
# Sub-path hosting (optional)
# Set only when the app is served from a folder rather than the domain root,
# e.g. https://example.com/psdata — then use /psdata (no trailing slash).
#
# Baked in at build time: change it and rebuild, or internal redirects will
# drop the prefix and 404.
# =============================================================================
NEXT_PUBLIC_BASE_PATH=
