# =============================================================================
# Supabase
# Project settings → API. The publishable/anon key is safe in the browser;
# Row Level Security is what protects the data behind it.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses Row Level Security. Server-side only — never expose to the browser.
# Used by the sync engine and by admin user provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Credential encryption
# Encrypts PrestaShop webservice keys at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
#
# Changing this makes existing stored keys unreadable; they must be re-entered.
# =============================================================================
CREDENTIALS_ENCRYPTION_KEY=

# =============================================================================
# Scheduled sync (optional)
# Shared secret required by POST /api/cron/sync. Generate with:
#   openssl rand -hex 32
# Leave unset to disable the scheduled endpoint entirely.
# =============================================================================
SYNC_CRON_SECRET=
