# Install devDependencies even when NODE_ENV=production.
#
# Building this project needs TypeScript (next.config.ts is TypeScript, and the
# build typechecks), Tailwind and its PostCSS plugin — all devDependencies. npm
# treats NODE_ENV=production as --omit=dev, so on a host that sets it (cPanel's
# Node.js selector does) a plain `npm ci` installs 82 packages instead of 389
# and the build fails while loading next.config.ts.
#
# Declared here rather than left to whoever runs the install, so `npm ci` is
# correct by default wherever it runs.
include=dev
